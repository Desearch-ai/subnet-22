# Copy to neurons/miners/.env. See docs/miner-setup.md for every setting.
WALLET_NAME=miner
WALLET_HOTKEY=default
TASK_API_URL=https://task-api.desearch.ai
# Comma separated http(s)://user:pass@host:port, rotated per request.
PROXY_URLS=
CRAWL_CONCURRENCY=32
CRAWL_CONCURRENCY_PER_DOMAIN=8
CRAWL_TIMEOUT=30
MAX_TASKS=4
EXTRACTION_THREADS=4
# Optional: pages your own address cannot load are retried through ScrapingDog.
SCRAPINGDOG_API_KEY=
SCRAPINGDOG_CONCURRENCY=8
RECEIPTS_FILE=
# Embed miner (python -m neurons.miners.embed): any OpenAI-compatible /embeddings endpoint.
EMBED_MODEL=qwen3-embedding-8b
EMBED_API_URL=https://openrouter.ai/api/v1/embeddings
EMBED_API_KEY=
EMBED_PROVIDERS=
