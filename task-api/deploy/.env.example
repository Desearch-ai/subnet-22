# Task api host
CF_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_REGION=auto
CF_R2_PUBLIC_OBJECTS=0
CF_R2_BUCKET=subnet-22
CF_R2_PAGES_BUCKET=desearch-pages
# The pages bucket on another S3 store; unset keeps it on the R2 endpoint
PAGES_S3_ENDPOINT=
PAGES_S3_REGION=
PAGES_S3_ACCESS_KEY_ID=
PAGES_S3_SECRET_ACCESS_KEY=
TASK_API_NETUID=22
TASK_API_NETWORK=finney
# ss58 hotkeys allowed to enqueue: the bot feeder's key
TASK_API_ADMIN_HOTKEYS=
# The receipt signing secret (a mnemonic or //uri); publish its ss58 from GET /v1/key
TASK_API_KEY_URI=
TASK_API_CORS_ORIGINS=https://mining.desearch.ai
# Host address the API is published on, for the reverse proxy in front of it
TASK_API_BIND=127.0.0.1:8080
# Embed tasks stay closed (0) until their inputs and vector publishing run.
TASK_API_EMBED_TASKS=0
TASK_API_EMBED_MODEL=desearch-4b-v1

# Bot box (/opt/task-api-feeder/.env)
TASK_API_URL=https://api-22.desearch.ai
FEEDER_KEY_URI=//feeder
